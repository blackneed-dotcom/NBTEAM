    method integer GetRequiredExperience(integer classId, integer level)
        -- Classes share the pre-job levels 0-5; the file starts class rows at 6.
        local levels = self.SourceExperience[classId]
        if levels == nil then return -1 end
        if level <= 5 then levels = self.SourceExperience[0] end
        return levels[level] or -1
    end

    method integer ResolveLevel(integer classId, integer level, integer experience)
        -- Preserve earned levels; advance using the same cumulative source as percentages.
        while level < 99 do
            local required = self:GetRequiredExperience(classId, level + 1)
            if required < 0 or experience < required then break end
            level = level + 1
        end
        return level
    end

    method string GainMessage(integer classId, integer level, integer gained)
        -- Use the level before the reward, including rewards that cross a level boundary.
        local current = self:GetRequiredExperience(classId, level)
        local following = self:GetRequiredExperience(classId, level + 1)
        local text = "경험치 " .. tostring(gained)
        if current >= 0 and following > current then
            local percent = gained * 100 / (following - current)
            local value = string.format("%.2f", percent)
            value = string.gsub(value, "0+$", "")
            value = string.gsub(value, "%.$", "")
            if gained > 0 and percent < 0.01 then value = "<0.01" end
            text = text .. " (" .. value .. "%)"
        end
        return text .. " 획득"
    end
end
