@Component
script BaramHUDController extends Component
    -- Shared presentation policy: original world pixels remain at 100 pixels/unit.
    -- 720 reference world pixels / 480 source UI pixels = camera zoom 150%.
    -- Original map_db.txt names, keyed by the imported client map entity.
    property table MapTitles = {["barambutcher"]="옥이네푸줏간",["barambuyeo"]="부여성",["baraminn"]="주막연실이네",["barambeginner"]="부여왕초보사냥1"}
    property number WorldZoomPercent = 150
    property Vector2 WorldScreenCenter = Vector2(0.2609375, 0.3625)
    -- Local prototype data, not saved character stats.
    property integer Hp = 100
    property integer MaxHp = 100
    property integer Mp = 80
    property integer MaxMp = 80
    property integer Level = 1
    property integer JobId = 0
    property integer JobRank = 0
    property integer Experience = 0
    property integer Gold = 0
    property integer Strength = 1
    property integer Dexterity = 1
    property integer Intelligence = 1
    property table BlueDigitRuids = {"43ee6da79b38401fa404733cf97a1256","b4ba58f65b4f4a13bdd348136bf495a4","e032be51714d44919e4ad028d077f914","878c6d32418a4c629b4cf261e4310ad7","3ad1822de80b48899ec39f0548e17d7e","4a271bf5fb2b4c9e97f97252563d1505","568d2e73477344599b5f1888b3c59867","6ea2a1b1c11749d18d9a02129e30fa68","b94c3470d2e44213b0f5a72c0b785efd","3fe5337e5e4649c7b6276f5b4e1eadfe"}
    property table DigitRuids = {"e0d44369789c448c9303130a928a3004","08317fa138334af1bedd1c310992d6f7","ff285f050a7f4b42a4b42a6e217ca1a1","7f649df3a1094d15a92a9e9d2ad77c11","017db0ffa46e4fdbbb7a9d3208b3da82","72b64abea23947e58e808e953f50c148","928a72a8bf2d4583ba9fb1c7177edbac","dd70a5a6a20e4f80a17011d59bf0e3b1","f93d20ecd3bc4f4b89bed2854fda70ae","b3c2aab674cc45ebaabe0705da4258c7"}
    property table GreenDigitRuids = {"8326dd4a490141d68620942ba4394de6","7b36bf8ecc6744c59ae87b6423f67670","1bb486f1ee7c4015a86f35f0f67aba94","1bbeea07ccce48a2931b3baa5102717d","d39d877456db4605b2d1813c205d2fed","91f2e616793d49b9b3cf75cdd76ae40e","d10f45282bae4ffc8e5e81eeef2cc037","802fb33ef1a14dacbef68909f6cec09c","24ac98e76e4d483b9a57fcb6abff5fd7","50da0d6ad64f439998f33a987e220858"}

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- Resolve fixed UI references once.
        self._T.mapTitle = self.Entity:GetChildByName("MapName", true)
        self._T.mapTitleKey = nil
        self:RefreshMapName()
        self._T.infoSignature = nil
        self._T.infoPanel = self.Entity:GetChildByName("CharacterInfo", true)
        self._T.infoButton = self.Entity:GetChildByName("InfoButton", true)
        self._T.infoClick = self._T.infoButton:ConnectEvent(UITouchDownEvent, function(evt) self:ToggleInfo() end)
        self._T.infoKey = _InputService:ConnectEvent(KeyDownEvent, function(evt)
            if _BaramChatRelay:IsInputBlocked() then return end
            if evt.key == KeyboardKey.Escape and isvalid(self._T.infoPanel) then self._T.infoPanel.Enable = false end
        end)
        self._T.worldCamera = nil
        self._T.rows = {}
        self._T.numberText = {}
        self._T.coordinates = nil
        self._T.coordinateRow = nil
        self._T.last = ""
        for _, rowName in ipairs({"Hp", "Mp", "Level", "Experience", "Gold", "Strength", "Dexterity", "Intelligence"}) do
            local row = self.Entity:GetChildByName("Row" .. rowName, true)
            self._T.rows[rowName] = row
        end
        self._T.hpFill = self.Entity:GetChildByName("HpFill", true)
        self._T.mpFill = self.Entity:GetChildByName("MpFill", true)
        -- ui6.png: colored remainder stays on the right; depletion advances from the left.
        self._T.hpFill.SpriteGUIRendererComponent.FillOrigin = 1
        self._T.mpFill.SpriteGUIRendererComponent.FillOrigin = 1
        -- Expand one opaque original EFT pixel to cover each complete 100x11 trough.
        for _, name in ipairs({"HpBackground", "MpBackground"}) do
            local background = self.Entity:GetChildByName(name, true)
            if isvalid(background) then background.UITransformComponent.UIScale = Vector3(100, 11, 1) end
        end
        self._T.jobBadge = self.Entity:GetChildByName("JobBadge", true)
        self._T.jobSignature = nil
        self:SetJob(_BaramWorld.LocalState.jobId or 0, _BaramWorld.LocalState.jobRank or 0)
        self:RefreshDisplay()
        self:SetCoordinates(_BaramWorld.LocalState.x or 0, _BaramWorld.LocalState.y or 0)
        log("[BaramHUD] ready: source frame, bitmap digits, HP/MP/level/experience/gold")
    end

    @ExecSpace("ClientOnly")
    method void SetCoordinates(integer x, integer y)
        -- winbaram 4E6CBF: %04u/%04u, 9x11 bank 2; slash is baked into USERSTAT.
        local text = string.format("%04d/%04d", x, y)
        if self._T.coordinates == text then return end
        local row = self._T.coordinateRow
        if not isvalid(row) then row = self.Entity:GetChildByName("RowCoordinates", true) self._T.coordinateRow = row end
        if not isvalid(row) then return end
        for i = 1, 9 do
            -- Walking normally changes one digit, not all eight original sprites.
            if self._T.coordinates ~= nil and string.sub(self._T.coordinates, i, i) == string.sub(text, i, i) then continue end
            local glyph = row:GetChildByName("Digit" .. tostring(i))
            local digit = tonumber(string.sub(text, i, i))
            glyph.Enable = digit ~= nil
            if digit ~= nil then glyph.SpriteGUIRendererComponent.ImageRUID = DataRef(self.DigitRuids[digit + 1]) end
        end
        self._T.coordinates = text
    end

    @ExecSpace("ClientOnly")
    method void RefreshMapName()
        -- Follow the local player map and draw its original client name only on change.
        local title = self._T.mapTitle
        if not isvalid(title) then return end
        local player = _UserService.LocalPlayer
        local currentMap = nil
        if isvalid(player) then currentMap = player.CurrentMap end
        local mapKey = ""
        -- [단일 맵 구조] MSW 씬은 이제 늘 baramcanvas 라 씬 이름으로는 못 가른다.
        -- 서버가 알려준 바람 맵 번호로 이름을 뽑는다. MapTitles 는 바람 맵의 name 을
        -- 그대로 열쇠로 쓰므로(barambuyeo, barambeginner …) 표는 손댈 것이 없다.
        local state = _BaramWorld.LocalState
        local data = (state ~= nil and state.map ~= nil) and _BaramWorldData:Map(state.map) or nil
        if data ~= nil then mapKey = string.lower(data.name)
        elseif isvalid(currentMap) then mapKey = string.lower(currentMap.Name) end
        if mapKey == self._T.mapTitleKey then return end
        local label = self.MapTitles[mapKey] or ""
        if label == "" and data ~= nil then label = data.label or "" end
        title.TextGUIRendererComponent.Text = label
        self._T.mapTitleKey = mapKey
        log("[BaramMapName] map=" .. mapKey .. " title=" .. label)
    end

    @ExecSpace("ClientOnly")
    method void SetVitals(integer hp, integer maxHp, integer mp, integer maxMp, integer level)
        -- Client-only entry point for future character-data integration.
        self.MaxHp = math.max(0, maxHp)
        self.MaxMp = math.max(0, maxMp)
        self.Hp = math.max(0, math.min(hp, self.MaxHp))
        self.Mp = math.max(0, math.min(mp, self.MaxMp))
        self.Level = math.max(1, math.min(99, level))
        self:RefreshDisplay()
    end

    @ExecSpace("ClientOnly")
    method void SetJob(integer jobId, integer jobRank)
        -- Reuse the original CLASS.EPF badge; update only when job metadata changes.
        if not _BaramJobs:ValidState({jobId = jobId, jobRank = jobRank}) then return end
        self.JobId = jobId
        self.JobRank = jobRank
        local signature = tostring(jobId) .. ":" .. tostring(jobRank)
        if not isvalid(self._T.jobBadge) or self._T.jobSignature == signature then return end
        self._T.jobBadge.SpriteGUIRendererComponent.ImageRUID = DataRef(_BaramJobs.BadgeRuids[jobId])
        self._T.jobSignature = signature
        log("[BaramJob] HUD=" .. _BaramJobs:GetName(jobId, jobRank))
    end

    @ExecSpace("ClientOnly")
    method void SetIdentity(integer nation, integer totem)
        -- Original bint.dat NATION.EPF/TOTEM.EPF with NPAL7.PAL, no substitute art.
        local nationBadge = self.Entity:GetChildByName("NationBadge", true)
        local totemBadge = self.Entity:GetChildByName("TotemBadge", true)
        if not isvalid(nationBadge) or not isvalid(totemBadge) then return end
        -- Show the untouched client pixels, fully opaque over the baked HUD badges.
        nationBadge.SpriteGUIRendererComponent.Color = Color.white
        totemBadge.SpriteGUIRendererComponent.Color = Color.white
        nationBadge.SpriteGUIRendererComponent.Type = ImageType.Simple
        totemBadge.SpriteGUIRendererComponent.Type = ImageType.Simple
        if nation == nil or totem == nil or nation < 0 or nation > 1 or totem < 0 or totem > 3 then
            nationBadge.Enable = false totemBadge.Enable = false return
        end
        local signature = tostring(nation) .. ":" .. tostring(totem)
        if self._T.identity == signature and nationBadge.Enable and totemBadge.Enable then return end
        -- Saved creation order: JuJak, BaekHo, HyunMu, CheongRyong.
        -- Original TOTEM frame order: JuJak, HyunMu, BaekHo, CheongRyong.
        local nations = {"e6d7ca80a20a41ab84e3f0e7b802756a", "6de2c06c46704e8f8182e92152fb1a05"}
        local totems = {"93570af020d8445dba314c1ed2b31d8d", "5364a251df5a4feeae267c917c9b6f7d", "180f6ddee1be4590864b61466dc347c5", "49cd63ada7d54a68bdb154288ebb2887"}
        nationBadge.SpriteGUIRendererComponent.ImageRUID = DataRef(nations[nation + 1])
        totemBadge.SpriteGUIRendererComponent.ImageRUID = DataRef(totems[totem + 1])
        nationBadge.Enable = true totemBadge.Enable = true
        self._T.identity = signature
        log("[BaramIdentity] nation=" .. ({"고구려", "부여"})[nation + 1] .. " totem=" .. ({"주작", "백호", "현무", "청룡"})[totem + 1])
    end

    @ExecSpace("ClientOnly")
    method void SetAttributes(integer strength, integer dexterity, integer intelligence)
        self.Strength = strength
        self.Dexterity = dexterity
        self.Intelligence = intelligence
        self:RefreshDisplay()
    end

    @ExecSpace("ClientOnly")
    method void DrawNumber(string rowName, integer value)
        -- Right-align the original 9x11 glyphs; no substituted font.
        local row = self._T.rows[rowName]
        if not isvalid(row) then return end
        local digits = tostring(math.max(0, math.floor(value)))
        local count = 10
        if rowName == "Hp" or rowName == "Mp" then count = 8 end
        if rowName == "Level" then count = 2 end
        if rowName == "Strength" or rowName == "Dexterity" or rowName == "Intelligence" then count = 3 end
        if #digits > count then digits = string.rep("9", count) end
        local text = string.rep(" ", count - #digits) .. digits
        local previous = self._T.numberText[rowName]
        if previous == text then return end
        for i = 1, count do
            if previous ~= nil and string.sub(previous, i, i) == string.sub(text, i, i) then continue end
            local entity = row:GetChildByName("Digit" .. tostring(i))
            local index = i - (count - #digits)
            entity.Enable = index > 0
            if index > 0 then
                local digit = tonumber(string.sub(digits, index, index))
                local glyphs = self.DigitRuids
                if rowName == "Hp" or rowName == "Mp" or rowName == "Experience" then glyphs = self.GreenDigitRuids end
                if rowName == "Strength" or rowName == "Dexterity" or rowName == "Intelligence" then glyphs = self.BlueDigitRuids end
                entity.SpriteGUIRendererComponent.ImageRUID = glyphs[digit + 1]
            end
        end
        self._T.numberText[rowName] = text
    end

    @ExecSpace("ClientOnly")
    method void RefreshDisplay()
        -- Quantize clipping to whole source pixels, preserving gauge texture.
        if self._T.rows == nil then return end
        local state = tostring(self.Hp) .. ":" .. tostring(self.MaxHp) .. ":" .. tostring(self.Mp) .. ":" .. tostring(self.MaxMp) .. ":" .. tostring(self.Level) .. ":" .. tostring(self.Experience) .. ":" .. tostring(self.Gold) .. ":" .. tostring(self.Strength) .. ":" .. tostring(self.Dexterity) .. ":" .. tostring(self.Intelligence)
        -- ReceiveState calls SetVitals for every step, even when only map/x/y changed.
        if state == self._T.last then return end
        local hp = math.max(0, math.min(self.Hp, math.max(0, self.MaxHp)))
        local mp = math.max(0, math.min(self.Mp, math.max(0, self.MaxMp)))
        local hpRatio = 0
        local mpRatio = 0
        if self.MaxHp > 0 then hpRatio = hp / self.MaxHp end
        if self.MaxMp > 0 then mpRatio = mp / self.MaxMp end
        self._T.hpFill.SpriteGUIRendererComponent.FillAmount = math.floor(hpRatio * 100) / 100
        self._T.mpFill.SpriteGUIRendererComponent.FillAmount = math.floor(mpRatio * 100) / 100
        self:DrawNumber("Hp", hp)
        self:DrawNumber("Mp", mp)
        self:DrawNumber("Level", math.max(1, math.min(99, self.Level)))
        self:DrawNumber("Experience", self.Experience)
        self:DrawNumber("Gold", self.Gold)
        self:DrawNumber("Strength", self.Strength)
        self:DrawNumber("Dexterity", self.Dexterity)
        self:DrawNumber("Intelligence", self.Intelligence)
        self._T.last = state
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        self:RefreshNickname()
        self:RefreshMapName()
        self:ApplyWorldPresentation()
        if isvalid(self._T.infoPanel) and self._T.infoPanel.Enable then self:RefreshInfo() end
        -- Update only when local values change.
        local state = tostring(self.Hp) .. ":" .. tostring(self.MaxHp) .. ":" .. tostring(self.Mp) .. ":" .. tostring(self.MaxMp) .. ":" .. tostring(self.Level) .. ":" .. tostring(self.Experience) .. ":" .. tostring(self.Gold) .. ":" .. tostring(self.Strength) .. ":" .. tostring(self.Dexterity) .. ":" .. tostring(self.Intelligence)
        if state ~= self._T.last then self:RefreshDisplay() end
    end

    @ExecSpace("ClientOnly")
    method void RefreshNickname()
        -- Left-align the selected character name in the empty field before the job/level.
        if not isvalid(self._T.nicknameField) then
            self._T.nicknameField = self.Entity:GetChildByName("Nickname", true)
            self._T.nicknameText = nil
        end
        local field = self._T.nicknameField
        if not isvalid(field) then return end
        local player = _UserService.LocalPlayer
        local available = _BaramEntryFlow.InWorld and isvalid(player) and isvalid(player.PlayerComponent)
        field.Enable = available
        if not available then self._T.nicknameText = nil return end
        local nickname = player.PlayerComponent.Nickname
        if nickname == self._T.nicknameText then return end
        _BaramProfile:Draw(field, nickname, true)
        self._T.nicknameText = nickname
        log("[BaramHUDName] updated=" .. nickname)
    end
    @ExecSpace("ClientOnly")
    method void ApplyWorldPresentation()
        -- Apply to each newly activated camera, including cameras on future maps.
        -- Zoom scales map tiles, actor pixels and visual offsets together.
        local camera = _CameraService:GetCurrentCameraComponent()
        if not isvalid(camera) then return end
        if self._T.worldCamera ~= camera then
            self:RestoreWorldCamera()
            self._T.worldCamera = camera
            self._T.oldZoom = camera.ZoomRatio
            self._T.oldScreenOffset = camera.ScreenOffset
            self._T.oldConfine = camera.ConfineCameraArea
            log("[BaramViewport] camera=" .. camera.Entity.Name .. " zoom=" .. tostring(self.WorldZoomPercent))
        end
        if camera.ZoomRatio ~= self.WorldZoomPercent then camera.ZoomRatio = self.WorldZoomPercent end
        camera.ConfineCameraArea = false
        camera.ScreenOffset = self.WorldScreenCenter
    end

    @ExecSpace("ClientOnly")
    method void RestoreWorldCamera()
        local camera = self._T.worldCamera
        if isvalid(camera) then
            camera.ZoomRatio = self._T.oldZoom
            camera.ScreenOffset = self._T.oldScreenOffset
            camera.ConfineCameraArea = self._T.oldConfine
        end
    end

    @ExecSpace("ClientOnly")
    method void ToggleInfo()
        if _BaramProfile:IsOpen() then _BaramProfile:Close() return end
        -- Select the status pane; repeated selection keeps it open.
        if not isvalid(self._T.infoPanel) then return end
        if not _BaramEntryFlow.InWorld or _BaramChatRelay.IsEditing then return end
        _BaramInput:Close()
        self._T.infoPanel.Enable = true
        self:RefreshInfo()
        log("[BaramInfo] visible=" .. tostring(self._T.infoPanel.Enable))
    end

    @ExecSpace("ClientOnly")
    method void RefreshInfo()
        local panel = self._T.infoPanel
        local player = _UserService.LocalPlayer
        if isvalid(player) then panel:GetChildByName("Name").TextGUIRendererComponent.Text = player.PlayerComponent.Nickname end
        local lines = {
            "레벨 " .. tostring(self.Level),
            "체력 " .. tostring(self.Hp) .. " / " .. tostring(self.MaxHp),
            "마력 " .. tostring(self.Mp) .. " / " .. tostring(self.MaxMp),
            "힘 " .. tostring(self.Strength) .. "  민첩 " .. tostring(self.Dexterity) .. "  지력 " .. tostring(self.Intelligence),
            "누적 경험치 " .. tostring(self.Experience),
            "금전 " .. tostring(self.Gold)
        }
        local signature = table.concat(lines, "|")
        if self._T.infoSignature == signature then return end
        self._T.infoSignature = signature
        for i = 1, 6 do panel:GetChildByName("Line" .. tostring(i - 1)).TextGUIRendererComponent.Text = lines[i] end
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        if self._T.infoKey ~= nil then _InputService:DisconnectEvent(KeyDownEvent, self._T.infoKey) end
        if isvalid(self._T.infoButton) and self._T.infoClick ~= nil then self._T.infoButton:DisconnectEvent(UITouchDownEvent, self._T.infoClick) end
        self:RestoreWorldCamera()
    end
end
