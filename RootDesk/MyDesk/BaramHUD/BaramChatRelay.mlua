@Logic
script BaramChatRelay extends Logic
    -- Session-wide transport. UI references and editing state remain client-only.
    property boolean IsEditing = false
    property number InputBlockSeconds = 0
    -- Temporary public command: disable here, or remove this block and TryCreateItem.
    property boolean TemporaryItemCommandEnabled = true

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        -- Rate limits belong to the current world session only.
        self._T.lastSent = {}
        self._T.clock = 0
        log("[BaramChatRelay] same-map server relay ready")
    end

    method void OnUpdate(number delta)
        -- Advance a session clock and the client input-release guard.
        if self:IsServer() then
            self._T.clock = (self._T.clock or 0) + delta
        else
            self.InputBlockSeconds = math.max(0, self.InputBlockSeconds - delta)
        end
    end

    @ExecSpace("ClientOnly")
    method boolean IsInputBlocked()
        -- Shared guard for gameplay movement and HUD keyboard shortcuts.
        return not _BaramEntryFlow.InWorld or self.IsEditing or self.InputBlockSeconds > 0 or _BaramInput:Blocked()
    end

    @ExecSpace("Server")
    method void RequestMessage(string message)
        -- Resolve identity on the server and deliver to the same map instance only.
        if self:TryCreateItem(senderUserId, message) then return end
        if message == "/진단" then self:SendDiagnostics(senderUserId) return end
        _BaramChatChannels:Send(senderUserId, message)
    end

    @ExecSpace("ServerOnly")
    method boolean TryCreateItem(string userId, string message)
        local command = string.match(message, "^%s*(%S+)")
        if command ~= "/아이템생성" then return false end
        local player = _UserService:GetUserEntityByUserId(userId)
        if not self.TemporaryItemCommandEnabled or not isvalid(player) then return true end
        local r = _BaramWorld:GetRecord(userId)
        if r == nil or not r.active or r.leaving or r.tradeBusy or r.trade ~= nil or r.state.hp <= 0 then
            self:ReceiveNotice("현재 상태에서는 아이템을 생성할 수 없습니다.", userId)
            return true
        end
        local name, digits = string.match(message, "^%s*/아이템생성%s+(.+)%s+(%d+)%s*$")
        local count = tonumber(digits)
        if name == nil or count == nil or count < 1 or count > 4294967295 then
            self:ReceiveNotice("사용법: /아이템생성 이름 갯수 (예: /아이템생성 목도 1)", userId)
            return true
        end
        name = string.match(name, "^%s*(.-)%s*$")
        local item = nil
        for _, data in pairs(_BaramWorldData.Items) do
            if data.name == name then
                if item ~= nil then
                    self:ReceiveNotice("같은 이름의 아이템이 여러 개 있어 생성할 수 없습니다.", userId)
                    return true
                end
                item = data
            end
        end
        if item == nil then
            self:ReceiveNotice("원본 데이터에 없는 아이템 이름입니다: " .. name, userId)
            return true
        end
        local art = _BaramInput.InventoryImages[tostring(item.id)]
        if art == nil or art.ruid == nil or art.ruid == "" then
            self:ReceiveNotice("바닥에 표시할 원본 이미지가 없는 아이템입니다.", userId)
            return true
        end
        _BaramWorld:DropLoot(r.state.map, r.state.x, r.state.y, item.id, count)
        local drop = _BaramWorld._T.drops[_BaramWorld._T.nextDrop]
        drop.durability = item.durability
        self:ReceiveNotice(name .. " " .. tostring(count) .. "개를 발밑에 생성했습니다.", userId)
        log("[TemporaryItemDrop] item=" .. tostring(item.id) .. " count=" .. tostring(count) .. " user=" .. userId)
        return true
    end

    @ExecSpace("ServerOnly")
    method void SendDiagnostics(string userId)
        -- Read-only diagnostics, addressed only to the authenticated requesting player.
        local player = _UserService:GetUserEntityByUserId(userId)
        if not isvalid(player) then return end
        if self._T.diagnosticTimes == nil then self._T.diagnosticTimes = {} end
        local now = self._T.clock or 0
        if now - (self._T.diagnosticTimes[userId] or -10) < 3 then return end
        self._T.diagnosticTimes[userId] = now
        local map = player.CurrentMap
        local record = _BaramWorld:GetRecord(userId)
        local count = 0
        local active = 0
        if isvalid(map) then
            for _, other in ipairs(_UserService:GetUsersByMapComponent(map.MapComponent) or {}) do
                count = count + 1
                local state = _BaramWorld:GetRecord(other.PlayerComponent.UserId)
                if state ~= nil and state.active then active = active + 1 end
            end
        end
        local message = "[진단 v1]\n서버 ID: " .. _WorldInstanceService.WorldInstanceId
        message = message .. "\n맵: " .. (isvalid(map) and map.Name or "없음")
        message = message .. "\n맵 ID: " .. (isvalid(map) and map.Id or "없음")
        message = message .. "\n서버 인원: " .. tostring(_UserService:GetUserCount())
        message = message .. "\n같은 맵: " .. tostring(count) .. " / 입장 완료: " .. tostring(active)
        message = message .. "\n내 서버 입장: " .. (record ~= nil and record.active and "완료" or "미완료")
        self:ReceiveDiagnostics(message, userId)
        log("[MeetDiagnostics] read-only report sent")
    end

    @ExecSpace("Client")
    method void ReceiveDiagnostics(string message)
        -- Keep the full IDs for exact comparison, including when the panel wraps lines.
        local report = message .. "\n내 화면: " .. _BaramEntryFlow.State
        report = report .. " / 입장: " .. tostring(_BaramEntryFlow.InWorld)
        _BaramNotices:Append(report)
        log("[MeetDiagnostics] " .. report)
    end

    @ExecSpace("Client")
    method void ReceiveMessage(string mapId, string nickname, string message)
        -- Ignore delayed messages after a map change; display plain text only.
        if not _BaramEntryFlow.InWorld then return end
        local player = _UserService.LocalPlayer
        if not isvalid(player) or not isvalid(player.CurrentMap) or player.CurrentMap.Id ~= mapId then return end
        local root = _EntityService:GetEntityByPath("/ui/BaramHUD/ChatWindow")
        if not isvalid(root) then return end
        ---@type BaramChatHistory
        local history = root:GetComponent("script.BaramChatHistory")
        if isvalid(history) then history:AppendMessage(nickname, message) end
    end

    @ExecSpace("Client")
    method void ReceiveNotice(string message)
        -- Route system feedback to the original notice box above the level display.
        _BaramNotices:Append(message)
    end

    @ExecSpace("ServerOnly")
    @EventSender("Service", "UserService")
    handler HandleUserLeave(UserLeaveEvent event)
        -- Release rate-limit state for disconnected users.
        if self._T.lastSent ~= nil then self._T.lastSent[event.UserId] = nil end
        if self._T.diagnosticTimes ~= nil then self._T.diagnosticTimes[event.UserId] = nil end
    end
end
