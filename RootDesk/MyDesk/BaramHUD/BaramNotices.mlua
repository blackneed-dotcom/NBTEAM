@Logic
script BaramNotices extends Logic
    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- winbaram.exe 458ACA: (441,304)-(639,369); 4BDE34: 184px; 4BDBE1: 12px rows.
        self._T.messages = {}
        self._T.lines = {}
        self._T.offset = 0
        self._T.hover = false
        local panel = self:Panel()
        if not isvalid(panel) then log_error("[BaramNotices] missing message panel") return end
        self._T.enter = panel:ConnectEvent(UITouchEnterEvent, function(event) self._T.hover = true end)
        self._T.exit = panel:ConnectEvent(UITouchExitEvent, function(event) self._T.hover = false end)
        self._T.scroll = _InputService:ConnectEvent(MouseScrollEvent, function(event)
            if _BaramEntryFlow.InWorld and self._T.hover and event.ScrollDelta ~= 0 then
                self:Scroll(event.ScrollDelta > 0 and 1 or -1)
            end
        end)
        self:Refresh()
        log("[BaramNotices] original right-side message panel ready")
    end

    @ExecSpace("ClientOnly")
    method Entity Panel()
        -- UI is client-only; no RPC carries UI references.
        return _EntityService:GetEntityByPath("/ui/BaramHUD/Frame/NoticeHistory")
    end

    @ExecSpace("ClientOnly")
    method integer Width(integer cp)
        -- Use the original BARAM00.EFT advances, shared with the profile font atlas.
        if cp < 0 or cp > 65535 then cp = 63 end
        local row = _BaramProfile.FontWidths[math.floor(cp / 256) + 1]
        return string.sub(row, cp % 256 + 1, cp % 256 + 1) == "C" and 12 or 6
    end

    @ExecSpace("ClientOnly")
    method void Append(string message)
        -- Original 4BDA6E caps history at 200 entries; notices have no chat sender prefix.
        if message == nil or message == "" or utf8.len(message) == nil then return end
        if self._T.messages == nil then self._T.messages = {} end
        local rows = {}
        local line = ""
        local width = 0
        for _, cp in utf8.codes(message) do
            if cp == 10 then
                table.insert(rows, line) line = "" width = 0
            elseif cp >= 32 then
                local advance = self:Width(cp)
                if width + advance > 184 then table.insert(rows, line) line = "" width = 0 end
                line = line .. utf8.char(cp)
                width = width + advance
            end
        end
        if line ~= "" then table.insert(rows, line) end
        if #rows == 0 then return end
        table.insert(self._T.messages, rows)
        while #self._T.messages > 200 do table.remove(self._T.messages, 1) end
        self._T.lines = {}
        for _, entry in ipairs(self._T.messages) do
            for _, value in ipairs(entry) do table.insert(self._T.lines, value) end
        end
        self._T.offset = 0
        self:Refresh()
        log("[BaramNotices] displayed entries=" .. tostring(#self._T.messages))
    end

    @ExecSpace("ClientOnly")
    method void Scroll(integer direction)
        -- Scroll inside the notice area without moving the ordinary chat history.
        local total = #(self._T.lines or {})
        self._T.offset = math.max(0, math.min(math.max(0, total - 5), (self._T.offset or 0) + direction))
        self:Refresh()
    end

    @ExecSpace("ClientOnly")
    method void Refresh()
        -- Five complete 12px lines fit the original 65px viewport.
        local panel = self:Panel()
        if not isvalid(panel) then return end
        local lines = self._T.lines or {}
        local first = math.max(1, #lines - 4 - (self._T.offset or 0))
        for i = 1, 5 do self:Draw(panel:GetChildByName("Line" .. tostring(i)), lines[first + i - 1] or "") end
    end

    @ExecSpace("ClientOnly")
    method void Draw(Entity field, string text)
        -- Thirty-two atlas cells accommodate narrow ASCII as well as full-width Korean.
        local points = {}
        for _, cp in utf8.codes(text) do
            if cp > 65535 then cp = 63 end
            local widths = _BaramProfile.FontWidths[math.floor(cp / 256) + 1]
            if string.sub(widths, cp % 256 + 1, cp % 256 + 1) == "0" then cp = 63 end
            table.insert(points, cp)
        end
        local x = 0
        for i = 1, 32 do
            local glyph = field:GetChildByName("Glyph" .. tostring(i))
            local cp = points[i]
            glyph.Enable = cp ~= nil
            if cp ~= nil then
                local width = self:Width(cp)
                glyph.UITransformComponent.anchoredPosition = Vector2(x, 0)
                glyph.UITransformComponent.RectSize = Vector2(width, 12)
                local atlas = glyph:GetChildByName("Atlas")
                local cell = cp % 16384
                atlas.SpriteGUIRendererComponent.ImageRUID = DataRef(_BaramProfile.FontPages[math.floor(cp / 16384) + 1])
                atlas.UITransformComponent.anchoredPosition = Vector2(-(cell % 128) * 16, math.floor(cell / 128) * 16)
                x = x + width
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- Release local input subscriptions at world-session shutdown.
        local panel = self:Panel()
        if isvalid(panel) then
            if self._T.enter ~= nil then panel:DisconnectEvent(UITouchEnterEvent, self._T.enter) end
            if self._T.exit ~= nil then panel:DisconnectEvent(UITouchExitEvent, self._T.exit) end
        end
        if self._T.scroll ~= nil then _InputService:DisconnectEvent(MouseScrollEvent, self._T.scroll) end
    end
end
