@Logic
script BaramEntryFlow extends Logic
    property boolean InWorld = false
    property string State = "loading"
    property boolean Ready = false
    property boolean Busy = false
    property number RequestWait = 0
    property boolean HasCharacter = false
    property integer Gender = 0
    property integer Hair = 0
    property integer Nation = 0
    property integer Totem = 0
    property integer PreviewDirection = 2
    property string StorageKey = "BaramCharacterV1"
    property integer SelectedSlot = 1
    property table Characters = {"", "", ""}
    property table Levels = {0, 0, 0}
    property boolean NamingExisting = false

    method void OnBeginPlay()
        if self:IsServer() then
            self._T.records = {}
            self._T.busy = {}
            self._T.levels = {}
            return
        end
        self.InWorld = false
        self.Ready = false
        self.Busy = false
        self.RequestWait = 0
        self.SelectedSlot = 1
        self.Characters = {"", "", ""}
        self.Levels = {0, 0, 0}
        self._T.requested = false
        self._T.links = {}
        self._T.assetsReady = false
        self:Show("loading")
        self:Bind("Title/New", "new")
        self:Bind("Title/Continue", "continue")
        for i = 1, 3 do self:Bind("Select/Slot" .. tostring(i), "slot" .. tostring(i)) end
        self:Bind("Select/New", "new")
        self:Bind("Select/Continue", "enter")
        self:Bind("Select/Cancel", "cancel")
        self:Bind("Create/Confirm", "create")
        self:Bind("Create/Cancel", "cancel")
        self:Bind("Create/Male", "male")
        self:Bind("Create/Female", "female")
        self:Bind("Create/Left", "left")
        self:Bind("Create/Right", "right")
        self:Bind("Create/Turn", "turn")
        self:Bind("Create/Goguryeo", "nation0")
        self:Bind("Create/Buyeo", "nation1")
        for i = 0, 3 do self:Bind("Create/Totem" .. tostring(i), "totem" .. tostring(i)) end
        self:Bind("Login/Confirm", "enter")
        self:Bind("Login/Cancel", "cancel")
        self:Bind("Notice/Confirm", "dismiss")
        self._T.nameSubmit = self:Find("Create/NameInput"):ConnectEvent(TextInputSubmitEvent, function(event)
            if self.State == "create" then self:Action("create") end
        end)
        self._T.key = _InputService:ConnectEvent(KeyDownEvent, function(event)
            if self.InWorld or self.Busy then return end
            if event.key == KeyboardKey.Escape then self:Action("cancel")
            elseif event.key == KeyboardKey.Return then
                if self.State == "notice" then self:Action("dismiss")
                elseif self.State == "login" or self.State == "select" then self:Action("enter") end
            elseif self.State == "select" then
                if event.key == KeyboardKey.UpArrow then self:Action("slot" .. tostring((self.SelectedSlot + 1) % 3 + 1))
                elseif event.key == KeyboardKey.DownArrow then self:Action("slot" .. tostring(self.SelectedSlot % 3 + 1)) end
            end
        end)
        local ruids = {"191bdff54c3148f08786f62683615493", "7a341bdc07eb43a68fb4aa4f17788cc0", "55ff75c1bf944e63830d342ba731f529"}
        for i, ruid in ipairs(ruids) do
            local sprite = _ResourceService:LoadSpriteAndWait(ruid)
            if sprite == nil then
                self:SetText("Loading/Text", "화면을 불러오지 못했습니다. 다시 실행해 주세요.")
                log_error("[BaramEntry] resource load failed")
                return
            end
            self:SetText("Loading/Text", "화면 불러오는 중 " .. tostring(i) .. " / 3")
        end
        self._T.assetsReady = true
        log("[BaramEntry] original screens loaded")
    end

    @ExecSpace("ClientOnly")
    method Entity Find(string path)
        return _EntityService:GetEntityByPath("/ui/BaramEntry/Frame/" .. path)
    end

    @ExecSpace("ClientOnly")
    method void SetText(string path, string value)
        local entity = self:Find(path)
        if isvalid(entity) then entity.TextGUIRendererComponent.Text = value end
    end

    @ExecSpace("ClientOnly")
    method void Bind(string path, string action)
        local entity = self:Find(path)
        local link = entity:ConnectEvent(UITouchDownEvent, function(event) self:Action(action) end)
        table.insert(self._T.links, {entity = entity, link = link})
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        if self.InWorld then return end
        if self.State == "create" then
            local inputEntity = self:Find("Create/NameInput")
            local input = inputEntity.TextGUIRendererInputComponent
            local bitmap = inputEntity:GetChildByName("Bitmap")
            local focused = input.IsFocused
            -- Native rendering owns IME composition and caret placement while editing.
            -- Only committed, unfocused text is drawn with the original bitmap font.
            if self._T.nameFocused ~= focused then
                inputEntity.TextGUIRendererComponent.Font = "Galmuri11"
                inputEntity.TextGUIRendererComponent.FontColor = Color(0, 0, 0, focused and 1 or 0)
                bitmap.Enable = not focused
                self._T.nameFocused = focused
                self._T.nameDrawn = nil
            end
            if not focused then
                local text = input.Text
                if text == "" then text = "한글 2~6글자" end
                if self._T.nameDrawn ~= text then
                    _BaramProfile:Draw(bitmap, text, true)
                    self._T.nameDrawn = text
                end
            end
        end
        if self.Busy then
            self.RequestWait = self.RequestWait + delta
            if self.RequestWait >= 30 then
                self.Busy = false
                self.RequestWait = 0
                self:Notice("서버 응답을 받지 못했습니다. 잠시 후 다시 시도해 주세요.")
                log_warning("[BaramEntry] request timed out; controls released")
            end
        else self.RequestWait = 0 end
        if not self._T.requested and isvalid(_UserService.LocalPlayer) then
            self._T.requested = true
            self:LoadCharacter()
        end
        if self.State == "loading" and self.Ready and self._T.assetsReady then self:Show("title") end
    end

    @ExecSpace("ClientOnly")
    method void Show(string state)
        self.State = state
        for _, name in ipairs({"Title", "Create", "Login", "Select", "Loading", "Notice"}) do
            local entity = self:Find(name)
            if isvalid(entity) then entity.Enable = string.lower(name) == state or (name == "Title" and (state == "login" or state == "select" or state == "notice")) end
        end
        local hud = _EntityService:GetEntityByPath("/ui/BaramHUD/Frame")
        if isvalid(hud) then hud.Enable = self.InWorld end
        if state == "create" then self:UpdateSelection() end
        if state == "select" then self:UpdateSlots() end
        log("[BaramEntry] screen=" .. state)
    end

    @ExecSpace("ClientOnly")
    method void Notice(string message)
        -- Remember the screen so dismissing an occupied-slot warning keeps the selection.
        if self.State ~= "notice" then self._T.noticeReturn = self.State end
        self:SetText("Notice/Text", message)
        self:Show("notice")
    end

    @ExecSpace("ClientOnly")
    method void Action(string action)
        if self.Busy or self.InWorld or not self.Ready then return end
        if action == "cancel" or action == "dismiss" then
            if self.State == "notice" then self:Show(self._T.noticeReturn or "title") return end
            if self.State == "create" or self.State == "login" then self:Show("select") return end
            if self._T.savedSelection ~= nil then
                self.Gender = self._T.savedSelection.gender
                self.Hair = self._T.savedSelection.hair
                self.Nation = self._T.savedSelection.nation
                self.Totem = self._T.savedSelection.totem
            end
            self:Show("title")
            return
        end
        if action == "new" and self.State == "title" then
            self:Show("select")
            if self.HasCharacter then self:Notice("이미 생성된 캐릭터가 있습니다.\n빈 슬롯을 선택해 처음하기를 눌러 주세요.")
            else self:BeginCreation() end
        elseif action == "continue" and self.State == "title" then
            self:Show("select")
        elseif self.State == "select" then
            if string.sub(action, 1, 4) == "slot" then
                local slot = tonumber(string.sub(action, 5)) or 0
                if slot >= 1 and slot <= 3 then self.SelectedSlot = slot self:UpdateSlots() end
            elseif action == "new" then self:BeginCreation()
            elseif action == "enter" then
                if self.Characters[self.SelectedSlot] == "" then self:Notice("아직 생성되지 않은 캐릭터입니다.\n처음하기를 눌러 만들어 주세요.") return end
                if self:DecodeRecord(self.Characters[self.SelectedSlot]).nickname == "" then self:BeginNaming() return end
                self.Busy = true
                self:EnterCharacter(self.SelectedSlot)
            end
        elseif self.State == "create" then
            if self.NamingExisting and action ~= "create" then return end
            if action == "male" then self.Gender = 0
            elseif action == "female" then self.Gender = 1
            elseif action == "nation0" then self.Nation = 0
            elseif action == "nation1" then self.Nation = 1
            elseif action == "left" then self.Hair = (self.Hair + 9) % 10
            elseif action == "right" then self.Hair = (self.Hair + 1) % 10
            elseif action == "turn" then self.PreviewDirection = (self.PreviewDirection + 1) % 4
            elseif string.sub(action, 1, 5) == "totem" then self.Totem = tonumber(string.sub(action, 6)) or 0
            elseif action == "create" then
                local input = self:Find("Create/NameInput").TextGUIRendererInputComponent
                local nickname = input.Text
                local error = _BaramNames:Validate(nickname)
                if error ~= "" then self:SetText("Create/Status", error) return end
                self.Busy = true
                self:SetText("Create/Status", "캐릭터를 저장하고 있습니다...")
                self:CreateCharacter(self.SelectedSlot, self.Gender, self.Nation, self.Totem, self.Hair, nickname)
            end
            self:UpdateSelection()
        elseif action == "enter" and self.State == "login" then
            self.Busy = true
            self:EnterCharacter(self.SelectedSlot)
        end
    end

    @ExecSpace("ClientOnly")
    method void BeginCreation()
        -- Creation only targets an empty slot; existing characters are never edited here.
        if self.Characters[1] ~= "" and self.Characters[2] ~= "" and self.Characters[3] ~= "" then
            self:Notice("이미 생성된 캐릭터입니다.\n캐릭터는 최대 3개까지 생성할 수 있습니다.") return
        end
        if self.Characters[self.SelectedSlot] ~= "" then self:Notice("이미 생성된 캐릭터입니다.\n빈 슬롯을 선택해 주세요.") return end
        self.Gender = 0 self.Hair = 0 self.Nation = 0 self.Totem = 0 self.PreviewDirection = 2
        self.NamingExisting = false
        self:Find("Create/NameInput").TextGUIRendererInputComponent.Text = ""
        self:Show("create")
        self:Find("Create/NameInput").TextGUIRendererInputComponent:ActivateInputField()
        self:SetText("Create/Status", tostring(self.SelectedSlot) .. "번 슬롯에 새 캐릭터를 만듭니다.")
    end

    @ExecSpace("ClientOnly")
    method void BeginNaming()
        -- Existing unnamed characters only gain a name; appearance and progression stay intact.
        local saved = self:DecodeRecord(self.Characters[self.SelectedSlot])
        self.Gender = saved.gender self.Hair = saved.hair self.Nation = saved.nation self.Totem = saved.totem
        self.NamingExisting = true
        self:Find("Create/NameInput").TextGUIRendererInputComponent.Text = ""
        self:Show("create")
        self:SetText("Create/Status", "기존 캐릭터의 이름을 정해 주세요. 외형과 진행 정보는 유지됩니다.")
        self:Find("Create/NameInput").TextGUIRendererInputComponent:ActivateInputField()
    end

    @ExecSpace("ClientOnly")
    method void UpdateSlots()
        -- Render each saved appearance with its actual persisted or in-session level.
        for i = 1, 3 do
            local path = "Select/Slot" .. tostring(i)
            local raw = self.Characters[i] or ""
            local occupied = raw ~= ""
            local saved = self:DecodeRecord(raw)
            local label = saved.nickname ~= "" and saved.nickname or "이름 설정 필요"
            self:SetText(path .. "/Label", occupied and (label .. " : 레벨 [ " .. tostring(self.Levels[i]) .. " ]") or "빈 슬롯 · 처음하기")
            self:SetText(path .. "/Number", tostring(i))
            self:Find(path).SpriteGUIRendererComponent.Color = i == self.SelectedSlot and Color(0.42, 0.23, 0.08, 0.3) or Color(0, 0, 0, 0)
            self:Find(path .. "/Body").Enable = occupied
            self:Find(path .. "/Head").Enable = occupied
            self:Find(path .. "/Halo").Enable = occupied
            if occupied then
                self:Find(path .. "/Body").SpriteGUIRendererComponent.ImageRUID = DataRef(_BaramAppearance:GetBody(saved.gender, 6))
                self:Find(path .. "/Head").SpriteGUIRendererComponent.ImageRUID = DataRef(_BaramAppearance:GetHead(saved.hair, 6))
            end
        end
        log("[BaramSlots] selected=" .. tostring(self.SelectedSlot) .. " level=" .. tostring(self.Levels[self.SelectedSlot]))
    end

    method string SlotKey(string baseKey, integer slot)
        -- Slot one retains the legacy key, preserving existing character and world saves.
        return slot == 1 and baseKey or (baseKey .. "_" .. tostring(slot))
    end

    @ExecSpace("ClientOnly")
    method void UpdateSelection()
        local gender = self.Gender == 0 and "남자" or "여자"
        local nation = self.Nation == 0 and "고구려" or "부여"
        local totems = {"주작", "백호", "현무", "청룡"}
        self:SetText("Create/Selection", gender .. " · " .. nation .. " · " .. totems[self.Totem + 1])
        self:SetText("Create/NationText", nation)
        self:SetText("Create/TotemText", totems[self.Totem + 1])
        local motion = self.PreviewDirection * 3
        self:Find("Create/Preview").SpriteGUIRendererComponent.ImageRUID = DataRef(_BaramAppearance:GetBody(self.Gender, motion))
        self:Find("Create/PreviewHead").SpriteGUIRendererComponent.ImageRUID = DataRef(_BaramAppearance:GetHead(self.Hair, motion))
        self:SetText("Create/PreviewLabel", "머리 " .. tostring(self.Hair + 1) .. " / 10")
        log("[BaramAppearance] preview gender=" .. tostring(self.Gender) .. " hair=" .. tostring(self.Hair) .. " frame=" .. tostring(motion))
    end

    @ExecSpace("Server")
    method void LoadCharacter()
        self:LoadForUser(senderUserId)
    end

    @ExecSpace("ServerOnly")
    method void LoadForUser(string userId)
        if self._T.busy[userId] then return end
        local player = _UserService:GetUserEntityByUserId(userId)
        if not isvalid(player) then return end
        if self._T.records[userId] ~= nil then
            self:SendSlots(userId)
            return
        end
        local loadTicket = {}
        self._T.busy[userId] = loadTicket
        local storage = _DataStorageService:GetUserDataStorage(player.PlayerComponent.ProfileCode)
        local keys = {}
        for i = 1, 3 do
            table.insert(keys, self:SlotKey(self.StorageKey, i))
            table.insert(keys, self:SlotKey(_BaramWorld.StorageKey, i))
        end
        local code, pages = storage:BatchGetAndWait(keys)
        local loaded = {}
        if code == 0 then
            while true do
                local rows = pages:GetCurrentPageDatas()
                if rows ~= nil then for _, row in ipairs(rows) do loaded[row.KeyInfo.Key] = row.Value end end
                if pages.IsLastPage then break end
                code = pages:LoadNextPageAndWait()
                if code ~= 0 then break end
                pages:MoveToNextPageAndWait()
            end
        end
        if self._T.busy[userId] ~= loadTicket or not isvalid(player) or _UserService:GetUserEntityByUserId(userId) ~= player then return end
        self._T.busy[userId] = nil
        if code ~= 0 then
            self:ReceiveSlots({"", "", ""}, {0, 0, 0}, false, userId)
            log_warning("[BaramEntry] load failed code=" .. tostring(code))
            return
        end
        local profiles = {"", "", ""}
        local levels = {0, 0, 0}
        for i = 1, 3 do
            local raw = loaded[self:SlotKey(self.StorageKey, i)] or ""
            local world = loaded[self:SlotKey(_BaramWorld.StorageKey, i)] or ""
            if (raw ~= "" and not self:IsValidRecord(raw)) or (raw == "" and world ~= "") then
                self:ReceiveSlots(profiles, levels, false, userId)
                log_warning("[BaramSlots] invalid profile; all original keys preserved") return
            end
            profiles[i] = raw
            levels[i] = raw ~= "" and 1 or 0
            if world ~= "" then
                local ok, state = pcall(function() return _HttpService:JSONDecode(world) end)
                if not ok or not _BaramWorld:ValidState(state) then
                    self:ReceiveSlots(profiles, levels, false, userId)
                    log_warning("[BaramSlots] invalid world save; original keys preserved") return
                end
                levels[i] = state.level
            end
        end
        self._T.records[userId] = profiles
        self._T.levels[userId] = levels
        self:SendSlots(userId)
        log("[BaramSlots] loaded three slots; legacy slot one preserved")
    end

    @ExecSpace("Server")
    method void CreateCharacter(integer slot, integer gender, integer nation, integer totem, integer hair, string nickname)
        -- Dispatch only with the authenticated caller ID.
        self:CreateForUser(senderUserId, slot, gender, nation, totem, hair, nickname)
    end

    @ExecSpace("ServerOnly")
    method void CreateForUser(string userId, integer slot, integer gender, integer nation, integer totem, integer hair, string nickname)
        -- Validate the cap and occupied slot on the server, including forged requests.
        if self._T.busy[userId] or self._T.records[userId] == nil then return end
        if slot < 1 or slot > 3 then self:CreationResult(false, "캐릭터는 최대 3개까지 생성할 수 있습니다.", userId) return end
        if gender < 0 or gender > 1 or nation < 0 or nation > 1 or totem < 0 or totem > 3 or hair < 0 or hair > 9 then self:CreationResult(false, "캐릭터 선택 정보를 확인해 주세요.", userId) return end
        local active = _BaramWorld:GetRecord(userId)
        if active ~= nil and active.active then return end
        local nameError = _BaramNames:Validate(nickname)
        if nameError ~= "" then self:CreationResult(false, nameError, userId) return end
        local profiles = self._T.records[userId]
        local levels = self._T.levels[userId]
        local previous = profiles[slot]
        if previous ~= "" and self:DecodeRecord(previous).nickname ~= "" then
            self:CreationResult(false, "이미 생성된 캐릭터입니다.", userId)
            log("[BaramSlots] duplicate creation blocked slot=" .. tostring(slot)) return
        end
        local player = _UserService:GetUserEntityByUserId(userId)
        if not isvalid(player) then return end
        if self._T.nameCooldown == nil then self._T.nameCooldown = {} end
        if (self._T.nameCooldown[userId] or 0) > _BaramWorld.Clock then self:CreationResult(false, "잠시 후 다시 시도해 주세요.", userId) return end
        self._T.nameCooldown[userId] = _BaramWorld.Clock + 3
        if previous ~= "" then
            local old = self:DecodeRecord(previous)
            gender = old.gender nation = old.nation totem = old.totem hair = old.hair
        end
        local ticket = {}
        self._T.busy[userId] = ticket
        local raw = "3:" .. tostring(gender) .. ":" .. tostring(nation) .. ":" .. tostring(totem) .. ":" .. tostring(hair) .. ":" .. nickname
        local storage = _DataStorageService:GetUserDataStorage(player.PlayerComponent.ProfileCode)
        local ok, result = pcall(function()
            local registry = _DataStorageService:GetGlobalDataStorage(_BaramNames.RegistryName)
            local bootstrap = _DataStorageService:GetSortableDataStorage(_BaramNames.BootstrapName)
            local owner = player.PlayerComponent.ProfileCode .. ":" .. tostring(slot)
            local claim = _BaramNames:Register(registry, bootstrap, owner, nickname, raw)
            if not claim.ok then return claim end
            raw = claim.value
            return _BaramNames:Persist(storage, self:SlotKey(self.StorageKey, slot), previous, raw)
        end)
        if self._T.busy[userId] ~= ticket then return end
        self._T.busy[userId] = nil
        if not isvalid(player) or _UserService:GetUserEntityByUserId(userId) ~= player or self._T.records[userId] ~= profiles then return end
        if ok and result.ok then
            profiles[slot] = raw
            if previous == "" then levels[slot] = 1 end
            self:SendSlots(userId)
            self:CreationResult(true, "캐릭터가 생성되었습니다.\n선택 후 이어하기를 눌러 주세요.", userId)
            log("[BaramNames] character name saved slot=" .. tostring(slot))
        else
            local message = "저장 결과를 확인하지 못했습니다. 같은 이름으로 다시 시도해 주세요."
            if ok and result.occupied then message = "이미 생성된 캐릭터입니다. 다시 접속해 주세요."
            elseif ok and result.value ~= nil then message = "이미 존재하는 이름입니다." end
            self:CreationResult(false, message, userId)
            log_warning("[BaramNames] creation refused or uncertain; existing data preserved")
        end
    end

    @ExecSpace("Server")
    method void EnterCharacter(integer slot)
        -- Enter only a server-owned occupied slot.
        local userId = senderUserId
        if self._T.busy[userId] then return end
        local profiles = self._T.records[userId]
        local raw = profiles ~= nil and slot >= 1 and slot <= 3 and profiles[slot] or ""
        local success = raw ~= nil and raw ~= ""
        if success and self:DecodeRecord(raw).nickname == "" then self:RequireName(slot, userId) return end
        if success then
            self._T.busy[userId] = true
            local ok, entered = pcall(function() return _BaramWorld:Enter(userId, raw, slot) end)
            self._T.busy[userId] = nil
            success = ok and entered == true
            if not ok then log_error("[BaramEntry] world entry failed: " .. tostring(entered)) end
        end
        self:EnterResult(success, userId)
    end

    @ExecSpace("Client")
    method void RequireName(integer slot)
        -- Server prevents bypassing the one-time naming screen for legacy characters.
        self.Busy = false
        self.SelectedSlot = slot
        self:BeginNaming()
    end

    @ExecSpace("ServerOnly")
    method void SendSlots(string userId)
        -- Prefer the live character level after saving/returning to the title.
        local profiles = self._T.records[userId]
        local levels = self._T.levels[userId]
        if profiles == nil or levels == nil then return end
        local current = _BaramWorld:GetRecord(userId)
        if current ~= nil then levels[current.slot or 1] = current.state.level end
        self:ReceiveSlots(profiles, levels, true, userId)
    end

    @ExecSpace("Client")
    method void ReceiveSlots(table profiles, table levels, boolean success)
        -- Display only server-supplied character names and levels.
        self.Ready = success
        if not success then self:SetText("Loading/Text", "캐릭터를 불러오지 못했습니다. 다시 실행해 주세요.") return end
        self.Characters = profiles self.Levels = levels
        self.HasCharacter = profiles[1] ~= "" or profiles[2] ~= "" or profiles[3] ~= ""
        if self.State == "select" then self:UpdateSlots() end
    end

    method boolean IsValidRecord(string raw)
        -- Version three appends a validated character name; legacy records remain readable.
        if string.match(raw, "^3:[01]:[01]:[0-3]:[0-9]:") ~= nil then return _BaramNames:Validate(string.sub(raw, 11)) == "" end
        return string.match(raw, "^[01]:[01]:[0-3]$") ~= nil or string.match(raw, "^2:[01]:[01]:[0-3]:[0-9]$") ~= nil
    end

    method table DecodeRecord(string raw)
        -- Keep all old appearance formats intact when adding the name field.
        local named = string.sub(raw, 1, 2) == "3:"
        local offset = (#raw == 9 or named) and 2 or 0
        return {gender = tonumber(string.sub(raw, 1 + offset, 1 + offset)) or 0,
            nickname = named and string.sub(raw, 11) or "",
            nation = tonumber(string.sub(raw, 3 + offset, 3 + offset)) or 0,
            totem = tonumber(string.sub(raw, 5 + offset, 5 + offset)) or 0,
            hair = offset == 2 and (tonumber(string.sub(raw, 9, 9)) or 0) or 0}
    end

    @ExecSpace("Client")
    method void CreationResult(boolean success, string message)
        self.Busy = false
        self:SetText("Create/Status", "")
        if success then self:Show("select") self:Notice(message)
        elseif self.State == "create" then self:SetText("Create/Status", message)
        else self:Notice(message) end
    end

    @ExecSpace("Client")
    method void EnterResult(boolean success)
        self.Busy = false
        if not success then self:Notice("게임에 접속하지 못했습니다. 잠시 후 이어하기를 다시 눌러 주세요.") return end
        self.InWorld = true
        self.State = "world"
        _EntityService:GetEntityByPath("/ui/BaramEntry").Enable = false
        _EntityService:GetEntityByPath("/ui/BaramHUD/Frame").Enable = true
        _BaramChatRelay.InputBlockSeconds = 0.2
        log("[BaramEntry] entered saved world / first start Buyeo")
    end

    @ExecSpace("ServerOnly")
    @EventSender("Service", "UserService")
    handler HandleUserLeave(UserLeaveEvent event)
        self._T.records[event.UserId] = nil
        self._T.busy[event.UserId] = nil
        self._T.levels[event.UserId] = nil
        if self._T.nameCooldown ~= nil then self._T.nameCooldown[event.UserId] = nil end
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        local nameInput = self:Find("Create/NameInput")
        if isvalid(nameInput) and self._T.nameSubmit ~= nil then nameInput:DisconnectEvent(TextInputSubmitEvent, self._T.nameSubmit) end
        for _, item in ipairs(self._T.links or {}) do
            if isvalid(item.entity) then item.entity:DisconnectEvent(UITouchDownEvent, item.link) end
        end
        if self._T.key ~= nil then _InputService:DisconnectEvent(KeyDownEvent, self._T.key) end
    end
end
