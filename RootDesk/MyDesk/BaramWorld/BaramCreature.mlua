@Component
script BaramCreature extends Component
    @Sync
    property integer SourceId = 1
    @Sync
    property integer GridX = 1
    @Sync
    property integer GridY = 1
    @Sync
    property integer Hp = 15
    @Sync
    property integer Facing = 6
    @Sync
    property integer Step = 0
    -- [단일 맵 구조] 모든 바람 맵이 캔버스 한 장 위에 있으므로 몹도 제 맵 번호를 들고 다닌다.
    @Sync
    property integer MapId = 315
    property string AggroUser = ""
    property number Wait = 1
    property number DeadWait = 0
    -- 이름표가 글자 대신 검은 네모로 나왔던 건 모델에 박힌 Font 가 "Galmuri9" 인데
    -- CustomFontGroupSet 의 Fonts 목록에는 그런 폰트가 없었기 때문이다(그룹 규칙만
    -- 그 이름을 가리키는 끊어진 참조였다). 실제로 등록된 건 Galmuri14 와 Chosun 뿐.
    -- Galmuri9 을 리소스로 올려 등록하면 LabelFont 를 그 이름으로 바꾸면 된다.
    property boolean ShowLabel = true
    property string LabelFont = "Galmuri14"
    -- 크기는 BaramInput.CreatureLabelScale 하나로 26마리를 한꺼번에 조절한다(F10).

    -- monster.dna 이미지 번호. 1=다람쥐(26) 2=토끼(22).
    method integer ImageId()
        return self.SourceId == 1 and 26 or 22
    end

    @ExecSpace("ServerOnly")
    method void PlayAttack()
        -- 피격과 사망은 Hp 가 @Sync 라 클라이언트가 알아서 본다.
        -- 공격만 바뀌는 상태가 없어서 따로 알려줘야 한다.
        if not isvalid(self.Entity.CurrentMap) then return end
        self:ReceiveAttack(self.Entity.CurrentMap.Id)
    end

    @ExecSpace("Client")
    method void ReceiveAttack(string mapId)
        if not isvalid(self.Entity.CurrentMap) or self.Entity.CurrentMap.Id ~= mapId then return end
        if self.Hp <= 0 then return end
        self._T.motion = "atk"
        self._T.motionAge = 0
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        -- Cache the presentation children; authoritative grid, AI and hitbox are unchanged.
        if not isvalid(self._T.sprite) then
            local source = self.Entity:GetChildByName("Sprite")
            self._T.label = self.Entity:GetChildByName("Label")
            if not isvalid(source) or not isvalid(self.Entity.CurrentMap) then return end
            self._T.spriteOffset = source.TransformComponent.Position
            -- A child still jumps with its synced parent before the next update.
            -- Clone only its original renderer under the map, as with player visuals.
            self._T.sprite = _SpawnService:SpawnByEntity(source, "CreatureVisual_" .. self.Entity.Id, source.TransformComponent.WorldPosition, self.Entity.CurrentMap)
            if not isvalid(self._T.sprite) then return end
            source.Visible = false
        end
        local sprite = self._T.sprite
        local label = self._T.label
        local imageId = self:ImageId()
        if self._T.imageId ~= imageId then
            self._T.imageId = imageId
            self._T.motionData = _BaramCreatureData:Get(imageId)
        end
        local motion = self._T.motionData
        -- 내 바람 맵이 아닌 몹은 숨기고 여기서 끝낸다.
        -- Visible=false 만으로는 OnUpdate 가 계속 돌아서, 몹이 많아지면 숨긴 것만으로도 부하다.
        local mine = _BaramWorld.LocalState
        if mine ~= nil and mine.map ~= nil and mine.map ~= self.MapId then
            if sprite.Visible then sprite.Visible = false end
            if isvalid(label) and label.Visible then label.Visible = false end
            return
        end
        local scale = _BaramInput.CreatureLabelScale
        if isvalid(label) and (self._T.labelFont ~= self.LabelFont or self._T.labelScale ~= scale) then
            self._T.labelFont = self.LabelFont
            self._T.labelScale = scale
            local renderer = label.TextRendererComponent
            renderer.Font = self.LabelFont
            -- FontColor 기본값이 검정이라 어두운 바닥에서 안 보인다.
            renderer.FontColor = Color(1, 1, 1, 1)
            label.TransformComponent.Scale = Vector3(scale, scale, 1)
        end
        if isvalid(label) and label.Visible ~= self.ShowLabel then label.Visible = self.ShowLabel end
        local direction = math.max(1, math.min(4, math.floor(self.Facing / 3) + 1))
        local root = self.Entity.TransformComponent.WorldPosition
        local offset = self._T.spriteOffset
        local target = Vector3(root.x + offset.x, root.y + offset.y, root.z + offset.z)
        local shown = self._T.shown or target
        local lastTarget = self._T.renderTarget or target
        local changed = target.x ~= lastTarget.x or target.y ~= lastTarget.y
        if changed then
            local dx, dy = target.x - lastTarget.x, target.y - lastTarget.y
            if self.Hp <= 0 or (self._T.lastHp or self.Hp) <= 0 or dx * dx + dy * dy > 0.0577 then
                shown = target
            end
            self._T.renderTarget = target
        end
        local dx, dy = target.x - shown.x, target.y - shown.y
        local distance = math.sqrt(dx * dx + dy * dy)
        if distance > 0 then
            local walk = motion ~= nil and motion.walk ~= nil and motion.walk[direction] or nil
            local duration = motion ~= nil and (motion.walkStep or 0.1) * (walk ~= nil and #walk or 4) or 0.4
            local step = math.min(distance, math.max(0, delta) * 0.24 / duration)
            shown = Vector3(shown.x + dx * step / distance, shown.y + dy * step / distance, target.z)
        end
        self._T.shown = shown
        self._T.renderTarget = target
        local actual = sprite.TransformComponent.WorldPosition
        if actual.x ~= shown.x or actual.y ~= shown.y then sprite.TransformComponent.WorldPosition = shown end

        if self._T.ready ~= true then
            self._T.ready = true
            self._T.lastHp = self.Hp
            self._T.step = self.Step
            -- KinematicbodyComponent 는 EnableShadow 가 기본 true 라 발밑에 타원을 깐다.
            -- ShadowSize 가 0.7 x 0.3 월드유닛 = 2.9칸 x 1.25칸이라 다람쥐보다 3배 크게 나온다.
            -- 플레이어는 이 컴포넌트가 없어서 그림자도 없었다.
            self.Entity.KinematicbodyComponent.EnableShadow = false
        end

        -- Hp 가 줄어든 걸 보고 피격/사망을 시작한다. 서버가 따로 안 쏴도 되고,
        -- 늦게 들어온 클라이언트는 lastHp 가 현재값이라 죽은 몹을 다시 죽이지 않는다.
        local last = self._T.lastHp
        if self.Hp <= 0 and last > 0 then
            self._T.motion = "dead"
            self._T.motionAge = 0
        elseif self.Hp > 0 and last > self.Hp then
            self._T.motion = "hit"
            self._T.motionAge = 0
        elseif self.Hp > 0 and last <= 0 then
            self._T.motion = nil
            self._T.step = self.Step
            self._T.walkAge = nil
        end
        self._T.lastHp = self.Hp

        if motion == nil then
            -- Motion 표에 없는 몹은 예전 12장 표로 그린다.
            local frame = _BaramCreatureData.Frames[self:ImageId()][self.Facing + self.Step % 3 + 1]
            if self._T.frame ~= frame then sprite.SpriteRendererComponent.SpriteRUID = frame self._T.frame = frame end
            sprite.Visible = self.Hp > 0
            if self.ShowLabel then label.TextRendererComponent.Text = self.Hp > 0 and ((self.SourceId == 1 and "다람쥐 " or "토끼 ") .. tostring(self.Hp)) or "" end
            return
        end

        if self.Hp <= 0 then
            if self.ShowLabel then label.TextRendererComponent.Text = "" end
            local age = self._T.motionAge or 0
            local hold = motion.deadHold or 1
            -- 원작은 사망 그림을 1초 보여주고 깜빡이다 사라진다. 그냥 없애면 뭘 잡았는지 안 보인다.
            if self._T.motion == "dead" and age < hold + 0.6 then
                local dead = motion.dead ~= nil and motion.dead[1] or nil
                if dead ~= nil and self._T.frame ~= dead then sprite.SpriteRendererComponent.SpriteRUID = dead self._T.frame = dead end
                sprite.Visible = age < hold or math.floor((age - hold) / 0.1) % 2 == 0
                self._T.motionAge = age + delta
            else
                sprite.Visible = false
            end
            return
        end

        sprite.Visible = true
        if self.ShowLabel then label.TextRendererComponent.Text = (self.SourceId == 1 and "다람쥐 " or "토끼 ") .. tostring(self.Hp) end

        local ruid = nil
        local playing = self._T.motion
        if playing == "hit" or playing == "atk" then
            local list = playing == "hit" and motion.hit or motion.atk
            list = list ~= nil and list[direction] or nil
            local span = playing == "hit" and (motion.hitStep or 0.7) or (motion.atkStep or 0.1)
            local age = self._T.motionAge or 0
            local index = math.floor(age / span) + 1
            if list == nil or index > #list then
                self._T.motion = nil
            else
                ruid = list[index]
                self._T.motionAge = age + delta
            end
        end

        if ruid == nil then
            -- 서버가 한 칸 옮기면 Step 이 바뀐다. 그때부터 걷기 4장을 한 바퀴 돌리고
            -- 끝나면 정지 자세로 돌아간다. 안 그러면 계속 걷는 자세로 서 있는다.
            if self._T.step ~= self.Step then
                self._T.step = self.Step
                self._T.walkAge = 0
            end
            local walk = motion.walk ~= nil and motion.walk[direction] or nil
            local span = motion.walkStep or 0.1
            local walkAge = self._T.walkAge
            if walk ~= nil and walkAge ~= nil and walkAge < span * #walk then
                ruid = walk[math.floor(walkAge / span) + 1]
                self._T.walkAge = walkAge + delta
            else
                self._T.walkAge = nil
                ruid = motion.idle ~= nil and motion.idle[direction] or nil
            end
        end

        if ruid ~= nil and self._T.frame ~= ruid then
            sprite.SpriteRendererComponent.SpriteRUID = ruid
            self._T.frame = ruid
        end
    end

    @ExecSpace("ServerOnly")
    @EventSender("Self")
    handler HandleHit(HitEvent event)
        if self.Hp <= 0 or event.TotalDamage <= 0 or not isvalid(event.AttackerEntity) then return end
        local player = event.AttackerEntity.PlayerComponent
        if not isvalid(player) then return end
        local r = _BaramWorld:GetRecord(player.UserId)
        if r == nil or r.state.map ~= 315 then return end
        self.Hp = math.max(0, self.Hp - event.TotalDamage)
        _BaramHealthBars:ShowDamage(self.Entity, event.TotalDamage, self.MapId)
        local maximum = self.SourceId == 1 and 15 or 10
        _BaramHealthBars:ShowHit(self.Entity, self.Hp, maximum, self.Entity.CurrentMap.Id)
        self.AggroUser = player.UserId
        if self.Hp == 0 then
            self.DeadWait = 30
            self.Entity.HitComponent.Enable = false
            _BaramWorld:Killed(player.UserId, self.SourceId, self.GridX, self.GridY)
        end
        log("[BaramCombat] hit mob=" .. tostring(self.SourceId) .. " hp=" .. tostring(self.Hp))
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- Release the map-local visual without changing the server monster lifetime.
        if isvalid(self._T.sprite) then self._T.sprite:Destroy() end
        self._T.sprite = nil
    end
end
