    method void OnBeginPlay()
        self._T.byName = {}
        self._T.byId = {}
        for _, spell in ipairs(self.Spells) do
            self._T.byName[spell.name] = spell
            self._T.byId[spell.id] = spell
        end
    end

    method table ByName(string name)
        if self._T.byName == nil then self:OnBeginPlay() end
        return self._T.byName[name]
    end

    method table ById(integer id)
        if self._T.byId == nil then self:OnBeginPlay() end
        return self._T.byId[id]
    end

    method integer IdByName(string name)
        local spell = self:ByName(name)
        if spell == nil then return 0 end
        return spell.id
    end

    -- 원본 스크립트가 쓰는 이름 있는 상수(_힘타격체흡수 같은 것).
    -- 아직 아이템 속성이 없어서 전부 0 이다.
    method integer Constant(string name)
        return 0
    end
end
