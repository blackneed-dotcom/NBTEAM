    @ExecSpace("ClientOnly")
    method void Draw(Entity target, string imageName)
        -- Upload each original pixel buffer to its renderer once per play session.
        if self._T.drawn == nil then self._T.drawn = {} end
        local key = tostring(target.Id) .. imageName
        local renderer = target.PixelGUIRendererComponent
        if self._T.drawn[key] == nil then
            local source = self.Images[imageName]
            local palette = {}
            for i, rgba in ipairs(source.palette) do palette[i] = Color.FromHexCode(rgba) end
            local pixels = {}
            for _, row in ipairs(source.rows) do
                for i = 1, #row, 2 do
                    table.insert(pixels, palette[tonumber(string.sub(row, i, i + 1), 16) + 1])
                end
            end
            renderer:ResetWithColors(source.width, source.height, pixels)
            self._T.drawn[key] = true
            log("[BaramOriginalSkillArt] " .. imageName .. " pixels=" .. tostring(#pixels))
        end
        renderer.Enable = true
        target.SpriteGUIRendererComponent.Enable = false
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- Drop cached renderer identities when the play session ends.
        self._T.drawn = nil
    end
end
