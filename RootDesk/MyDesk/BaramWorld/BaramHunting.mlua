@Component
script BaramHunting extends Component
    -- 어느 바람 맵을 맡는지. 캔버스 한 장 위에 모두 올라가므로 씬이 아니라 이 번호로 가른다.
    property integer MapId = 315
    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        self:Prepare()
    end

    -- 두 번 불러도 한 번만 젠한다. 런타임에 컴포넌트를 붙이면 OnBeginPlay 가
    -- 안 올 수도 있어서 BaramWorld 가 이걸 직접 부른다.
    @ExecSpace("ServerOnly")
    method void Prepare()
        if self._T.creatures ~= nil then return end
        self._T.creatures = {}
        for kind = 1, 2 do
            for i = 1, 13 do
                local entity = _SpawnService:SpawnByModelId("baramcreature", "Wild_" .. tostring(kind) .. "_" .. tostring(i), Vector3.zero, self.Entity)
                if isvalid(entity) then
                    ---@type BaramCreature
                    local creature = entity:AddComponent("BaramCreature")
                    creature.SourceId = kind
                    creature.MapId = self.MapId
                    self:Respawn(creature)
                    table.insert(self._T.creatures, creature)
                end
            end
        end
        log("[BaramHunting] spawned=" .. tostring(#self._T.creatures))
    end

    @ExecSpace("ServerOnly")
    method boolean Occupied(integer x, integer y)
        for _, c in ipairs(self._T.creatures) do if isvalid(c) and c.Hp > 0 and c.GridX == x and c.GridY == y then return true end end
        for _, player in ipairs(_UserService.UserEntities.Values) do
            if isvalid(player) then
                local r = _BaramWorld:GetRecord(player.PlayerComponent.UserId)
                -- 씬이 아니라 바람 맵 번호로 본다. 이제 다른 맵 사람도 같은 씬에 있다.
                if r ~= nil and r.active and r.state.map == self.MapId and r.state.x == x and r.state.y == y then return true end
            end
        end
        return false
    end

    @ExecSpace("ServerOnly")
    method void Respawn(BaramCreature c)
        for attempt = 1, 100 do
            local x = _UtilLogic:RandomIntegerRange(1, 18)
            local y = _UtilLogic:RandomIntegerRange(1, 17)
            if _BaramWorldData:Walkable(self.MapId, x, y) and not self:Occupied(x, y) then
                c.GridX = x
                c.GridY = y
                c.Hp = c.SourceId == 1 and 15 or 10
                c.Wait = c.SourceId == 1 and 2 or 1.5
                c.AggroUser = ""
                c.Entity.HitComponent.Enable = true
                local p = _BaramWorldData:Position(x, y)
                c.Entity.KinematicbodyComponent:SetPosition(Vector2(p.x, p.y))
                return
            end
        end
        c.Hp = 0
        c.DeadWait = 1
    end

    -- 이 맵에 사람이 하나라도 있나. 아무도 없으면 몹을 움직이지 않는다.
    -- 안 움직이면 동기화도 안 나가므로, 맵이 늘어나도 부하가 "사람이 있는 맵"만큼만 든다.
    @ExecSpace("ServerOnly")
    method boolean Occupied2()
        for _, player in ipairs(_UserService.UserEntities.Values) do
            if isvalid(player) then
                local r = _BaramWorld:GetRecord(player.PlayerComponent.UserId)
                if r ~= nil and r.active and r.state.map == self.MapId then return true end
            end
        end
        return false
    end

    @ExecSpace("ServerOnly")
    method void OnUpdate(number delta)
        if self._T.creatures == nil then return end
        self._T.idleCheck = (self._T.idleCheck or 0) - delta
        if self._T.idleCheck <= 0 then
            self._T.idleCheck = 1
            self._T.awake = self:Occupied2()
        end
        if not self._T.awake then return end
        for _, c in ipairs(self._T.creatures) do
            if isvalid(c) then
                if c.Hp <= 0 then
                    c.DeadWait = c.DeadWait - delta
                    if c.DeadWait <= 0 then self:Respawn(c) end
                else
                    c.Wait = c.Wait - delta
                    if c.Wait <= 0 then
                        c.Wait = c.SourceId == 1 and 2 or 1.5
                        local direction = _UtilLogic:RandomIntegerRange(0, 3)
                        local target = _BaramWorld:GetRecord(c.AggroUser)
                        local counter = false
                        if c.SourceId == 1 and target ~= nil and target.active and target.state.map == self.MapId and target.state.hp > 0 then
                            local dx = target.state.x - c.GridX
                            local dy = target.state.y - c.GridY
                            if math.abs(dx) + math.abs(dy) == 1 then
                                -- 때릴 때는 플레이어 쪽을 보게 한다. 안 그러면 등 돌린 채로 때린다.
                                c.Facing = (dx > 0 and 1 or (dx < 0 and 3 or (dy > 0 and 2 or 0))) * 3
                                _BaramWorld:Damage(c.AggroUser, _UtilLogic:RandomIntegerRange(1, 2))
                                c:PlayAttack()
                                counter = true
                            elseif math.abs(dx) > math.abs(dy) then direction = dx > 0 and 1 or 3
                            else direction = dy > 0 and 2 or 0 end
                        end
                        if not counter then
                            local dx = {0, 1, 0, -1}
                            local dy = {-1, 0, 1, 0}
                            local x = c.GridX + dx[direction + 1]
                            local y = c.GridY + dy[direction + 1]
                            c.Facing = direction * 3
                            if x >= 1 and x <= 18 and y >= 1 and y <= 17 and _BaramWorldData:Walkable(self.MapId, x, y) and not self:Occupied(x, y) then
                                c.GridX = x c.GridY = y c.Step = c.Step % 2 + 1
                                local p = _BaramWorldData:Position(x, y)
                                c.Entity.KinematicbodyComponent:SetPosition(Vector2(p.x, p.y))
                            end
                        end
                    end
                end
            end
        end
    end

    @ExecSpace("ServerOnly")
    method void OnEndPlay()
        for _, c in ipairs(self._T.creatures or {}) do if isvalid(c) then c.Entity:Destroy() end end
    end
end
