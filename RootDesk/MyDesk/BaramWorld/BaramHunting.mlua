@Component
script BaramHunting extends Component
    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        self._T.creatures = {}
        for kind = 1, 2 do
            for i = 1, 13 do
                local entity = _SpawnService:SpawnByModelId("baramcreature", "Wild_" .. tostring(kind) .. "_" .. tostring(i), Vector3.zero, self.Entity)
                if isvalid(entity) then
                    ---@type BaramCreature
                    local creature = entity:AddComponent("BaramCreature")
                    creature.SourceId = kind
                    self:Respawn(creature)
                    table.insert(self._T.creatures, creature)
                end
            end
        end
        log("[BaramHunting] spawned=" .. tostring(#self._T.creatures))
    end

    @ExecSpace("ServerOnly")
    method boolean Occupied(integer x, integer y)
        for _, c in ipairs(self._T.creatures) do if isvalid(c) and c.Hp > 0 and c.GridX == x and c.GridY == y then return true end end
        for _, player in ipairs(_UserService.UserEntities.Values) do
            if isvalid(player) and player.CurrentMap == self.Entity then
                local r = _BaramWorld:GetRecord(player.PlayerComponent.UserId)
                if r ~= nil and r.active and r.state.x == x and r.state.y == y then return true end
            end
        end
        return false
    end

    @ExecSpace("ServerOnly")
    method void Respawn(BaramCreature c)
        for attempt = 1, 100 do
            local x = _UtilLogic:RandomIntegerRange(1, 18)
            local y = _UtilLogic:RandomIntegerRange(1, 17)
            if _BaramWorldData:Walkable(315, x, y) and not self:Occupied(x, y) then
                c.GridX = x
                c.GridY = y
                c.Hp = c.SourceId == 1 and 15 or 10
                c.Wait = c.SourceId == 1 and 2 or 1.5
                c.AggroUser = ""
                c.Entity.HitComponent.Enable = true
                local p = _BaramWorldData:Position(x, y)
                c.Entity.KinematicbodyComponent:SetPosition(Vector2(p.x, p.y))
                return
            end
        end
        c.Hp = 0
        c.DeadWait = 1
    end

    @ExecSpace("ServerOnly")
    method void OnUpdate(number delta)
        if self._T.creatures == nil then return end
        for _, c in ipairs(self._T.creatures) do
            if isvalid(c) then
                if c.Hp <= 0 then
                    c.DeadWait = c.DeadWait - delta
                    if c.DeadWait <= 0 then self:Respawn(c) end
                else
                    c.Wait = c.Wait - delta
                    if c.Wait <= 0 then
                        c.Wait = c.SourceId == 1 and 2 or 1.5
                        local direction = _UtilLogic:RandomIntegerRange(0, 3)
                        local target = _BaramWorld:GetRecord(c.AggroUser)
                        local counter = false
                        if c.SourceId == 1 and target ~= nil and target.active and target.state.map == 315 and target.state.hp > 0 then
                            local dx = target.state.x - c.GridX
                            local dy = target.state.y - c.GridY
                            if math.abs(dx) + math.abs(dy) == 1 then _BaramWorld:Damage(c.AggroUser, _UtilLogic:RandomIntegerRange(1, 2)) counter = true
                            elseif math.abs(dx) > math.abs(dy) then direction = dx > 0 and 1 or 3
                            else direction = dy > 0 and 2 or 0 end
                        end
                        if not counter then
                            local dx = {0, 1, 0, -1}
                            local dy = {-1, 0, 1, 0}
                            local x = c.GridX + dx[direction + 1]
                            local y = c.GridY + dy[direction + 1]
                            c.Facing = direction * 3
                            if x >= 1 and x <= 18 and y >= 1 and y <= 17 and _BaramWorldData:Walkable(315, x, y) and not self:Occupied(x, y) then
                                c.GridX = x c.GridY = y c.Step = c.Step % 2 + 1
                                local p = _BaramWorldData:Position(x, y)
                                c.Entity.KinematicbodyComponent:SetPosition(Vector2(p.x, p.y))
                            end
                        end
                    end
                end
            end
        end
    end

    @ExecSpace("ServerOnly")
    method void OnEndPlay()
        for _, c in ipairs(self._T.creatures or {}) do if isvalid(c) then c.Entity:Destroy() end end
    end
end
