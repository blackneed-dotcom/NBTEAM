@Logic
script BaramMapWarm extends Logic
    -- 맵 바닥/오브젝트 그림은 한 장이 아니라 960x960 청크로 쪼개져 있다.
    -- 맵을 넘어가면 그 청크들을 그때 처음 읽느라 지도가 조각조각 뜬다.
    -- 부여성이 32장이라 유독 티나고, 사냥터는 2장이라 거의 안 보인다.
    -- 포탈 근처에 가면 목적지 청크를 미리 훑어 캐시에 올려두려고 RUID 를 모아뒀다.
    -- map/*.map 의 map<번호>-ground / map<번호>-objects 엔티티에서 뽑은 값이다.
    property table Chunks = {
    [14] = {"e2fd4bef5bb3461ca74f8240255bfa86","8db66fe2109046dab0d2ca0fa4310713","d6ccbb9bf7684e23a71e633ba2d83ef7","b42a4287988e4c30b4b972487d114644","f4b793913b834c45bace4e607205931c","ce26b4366f1b46139d06d217e572e3cb","0f7eadc922264c9a8d90c3fbd851d0fd","38861d011de0428ba1624c4843a4dd92","33b96ed87af541e89799dcf5e584dd59","cc94543d4e5b438382fe95411f8f4e04","d5ac699975c54a148ffd82bcfd10fdd0","3be14b5fa504472fb06d26e03989d2e4","b2dd60592fe646f58d54e5529b3ce29d","386c4f85165545318d337b4d6a82187a","330b9928c973477ca9db54e0cb0acf54","d71b0a44c8ae455c80d69e49a00d58c2","2ddc9b3a809349288624d345355dbb5c","20efa81945c64059a83ac1da41dd409a","ba664f90e6f54d43a02b323e856ffd07","01bb6acf8c33472c895cd6e18bc42337","23498e0354824d4084c582c9cd7f1e41","3ce667606bc7478088e3d4e48c65fd6a","709f7cb703af40c8937043360dd4612a","e50d509ee8e443a78f7e86350a72b860","2d18d3906eac42408171b072378bd990","aaac69bc4cf04be7b0b36a383599049e","ecb722c0808e4c44ba9838c93981c6b6","7cc5713f6af84b8fb6e7e2ab4f1d6a3c","135e992e2194486ea9088e8fe9bc1353","da56bc2d825c47d68d87b0f75a84129e","d2da3ff07802469a87e0033c401a698c","36f5a8f3f2394b2ba35c11e016140bc2"},
    [15] = {"c612297f202f4650b9d4b7ab67c302e9","6c2f27392ebb412bb73b63f5dca9033a"},
    [7] = {"822d173a0364438982994a320e59f40a","759dba980d554458ac0c1e77c52722e6"},
    [315] = {"cacf01a3046f49018a6cd781886fb4a6","7f81f6d4dbe54f859a30514af72fc505"},
    }

    method table Get(integer mapId)
        return self.Chunks[mapId]
    end
end
