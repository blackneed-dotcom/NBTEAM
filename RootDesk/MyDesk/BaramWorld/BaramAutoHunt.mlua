-- 자동사냥 틀.
--
-- 아직 "틀"이다. 한 박자마다 한 번 판단하고, 판단은 아래 순서로만 한다:
--   1. 그만둘 때인가 (죽었거나, 체력이 바닥이거나, 교환 중이거나)
--   2. 근처에 잡을 게 있나
--   3. 붙어 있으면 때린다 / 떨어져 있으면 한 칸 다가간다
--   4. 마법을 걸어뒀고 마력이 되면 외운다
--
-- 일부러 여기서 다 하지 않는다. 걷기·때리기·마법은 이미 있는 길(BaramWorld,
-- BaramScriptRuntime)을 그대로 부르고, 이 파일은 "언제 무엇을" 만 정한다.
-- 그래야 나중에 사람이 직접 할 때와 자동일 때가 갈라지지 않는다.
@Logic
script BaramAutoHunt extends Logic
    -- 판단 간격(초). 걸음이 한 칸 0.32초라 그보다 조금 짧게 잡았다.
    property number ThinkSeconds = 0.3
    -- 체력이 이 비율 아래로 내려가면 스스로 멈춘다.
    property number HpFloor = 0.35
    -- 몇 칸 안에 있는 것만 쫓아간다.
    property integer Reach = 8

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        self._T.sessions = {}
    end

    @ExecSpace("ServerOnly")
    method table Session(string userId)
        if self._T.sessions == nil then self._T.sessions = {} end
        local s = self._T.sessions[userId]
        if s == nil then
            s = {on = false, wait = 0, spell = 0}
            self._T.sessions[userId] = s
        end
        return s
    end

    -- 채팅 /자동 으로 켜고 끈다. 주문 칸을 같이 주면 그 주문도 쓴다: /자동 a
    @ExecSpace("Server")
    method void Toggle(string letter)
        local userId = senderUserId
        local r = _BaramWorld:GetRecord(userId)
        if r == nil or not r.active then return end
        local s = self:Session(userId)
        if s.on then
            s.on = false
            _BaramWorld:Notice(userId, "자동사냥을 멈췄습니다.")
            return
        end
        s.spell = 0
        if letter ~= nil and letter ~= "" then
            local slot = self:SlotOfLetter(letter)
            if slot > 0 and _BaramScriptRuntime:SpellSlots()[tostring(slot)] ~= nil then
                s.spell = slot
            end
        end
        s.on = true
        s.wait = 0
        local extra = ""
        if s.spell > 0 then
            extra = " (" .. _BaramScriptRuntime:SpellSlots()[tostring(s.spell)].name .. ")"
        end
        _BaramWorld:Notice(userId, "자동사냥을 시작합니다." .. extra)
    end

    -- a~z 는 1~26, A~Z 는 27~52. BaramWorldData.InventoryLetter 의 반대다.
    @ExecSpace("ServerOnly")
    method integer SlotOfLetter(string letter)
        local code = string.byte(letter)
        if code == nil then return 0 end
        if code >= 97 and code <= 122 then return code - 96 end
        if code >= 65 and code <= 90 then return code - 38 end
        return 0
    end

    @ExecSpace("ServerOnly")
    method void Stop(string userId, string why)
        local s = self:Session(userId)
        if not s.on then return end
        s.on = false
        if why ~= nil and why ~= "" then _BaramWorld:Notice(userId, why) end
    end

    @ExecSpace("ServerOnly")
    method void OnUpdate(number delta)
        if self._T.sessions == nil then return end
        for userId, s in pairs(self._T.sessions) do
            if s.on then
                s.wait = s.wait - delta
                if s.wait <= 0 then
                    s.wait = self.ThinkSeconds
                    self:Think(userId, s)
                end
            end
        end
    end

    -- 한 박자. 여기서 하는 일은 딱 하나씩이다 — 때리거나, 한 칸 가거나, 외우거나.
    @ExecSpace("ServerOnly")
    method void Think(string userId, table s)
        local r = _BaramWorld:GetRecord(userId)
        if r == nil or not r.active then self:Stop(userId, "") return end
        if r.state.hp <= 0 then self:Stop(userId, "쓰러져서 자동사냥을 멈춥니다.") return end
        if r.trade ~= nil or r.tradeBusy then self:Stop(userId, "교환 중이라 자동사냥을 멈춥니다.") return end
        if r.state.hp < r.state.maxHp * self.HpFloor then
            self:Stop(userId, "체력이 모자라 자동사냥을 멈춥니다.")
            return
        end

        local target = self:Nearest(userId, r)
        if target == nil then return end

        local dx = target.GridX - r.state.x
        local dy = target.GridY - r.state.y
        if math.abs(dx) + math.abs(dy) == 1 then
            -- 붙어 있다. 바라보게 돌리고 때린다.
            local direction = (dx > 0 and 1) or (dx < 0 and 3) or (dy > 0 and 2) or 0
            _BaramWorld:MoveChecked(userId, direction, true)
            if s.spell > 0 and self:CastIfReady(userId, s, target) then return end
            _BaramWorld:AttackFor(userId)
            return
        end

        -- 멀다. 한 칸 다가간다. 먼 쪽부터 좁힌다.
        local direction = -1
        if math.abs(dx) >= math.abs(dy) and dx ~= 0 then direction = dx > 0 and 1 or 3
        elseif dy ~= 0 then direction = dy > 0 and 2 or 0 end
        if direction >= 0 then _BaramWorld:MoveChecked(userId, direction, false) end
    end

    -- 마력이 되면 걸어둔 주문을 외운다. 외웠으면 true.
    @ExecSpace("ServerOnly")
    method boolean CastIfReady(string userId, table s, BaramCreature target)
        local slots = _BaramScriptRuntime:SpellSlots()
        local spell = slots[tostring(s.spell)]
        if spell == nil then return false end
        local r = _BaramWorld:GetRecord(userId)
        if r == nil or r.state.mp < spell.mp then return false end
        if spell.kind == 2 or spell.kind == 9 then
            r.target = _BaramScriptRuntime:CreatureObjId(target)
        end
        _BaramScriptRuntime:Cast(userId, spell.name)
        return true
    end

    -- 같은 맵에서 가장 가까운 산 몹. 없으면 nil.
    @ExecSpace("ServerOnly")
    method BaramCreature Nearest(string userId, table r)
        local canvas = _BaramWorld:Stage(r.state.map)
        if not isvalid(canvas) then return nil end
        local best = nil
        local bestRange = self.Reach + 1
        for _, child in pairs(canvas.Children) do
            ---@type BaramCreature
            local creature = child:GetComponent("script.BaramCreature")
            if isvalid(creature) and creature.Hp > 0 and creature.MapId == r.state.map then
                local range = math.abs(creature.GridX - r.state.x) + math.abs(creature.GridY - r.state.y)
                if range < bestRange then bestRange = range best = creature end
            end
        end
        return best
    end
end
