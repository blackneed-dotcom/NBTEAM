    @ExecSpace("Client")
    method void Show(integer effectId, integer mapId, integer x, integer y, string entityId)
        -- Spawn a local sprite using the existing map chunk template, without its children.
        local state = _BaramWorld.LocalState
        local player = _UserService.LocalPlayer
        local frames = self.Sequences[effectId]
        if frames == nil or state == nil or state.map ~= mapId or not isvalid(player) then return end
        local map = player.CurrentMap
        if not isvalid(map) then return end
        local template = map:GetChildByName("Chunk00")
        if not isvalid(template) then return end
        if self._T.effects == nil then self._T.effects = {} end
        if #self._T.effects >= 64 then return end
        self._T.serial = (self._T.serial or 0) + 1
        local entity = _SpawnService:SpawnByEntity(template, "BaramSpellFx_" .. tostring(self._T.serial), _BaramWorldData:Position(x, y), map, false)
        if not isvalid(entity) then return end
        local sprite = entity.SpriteRendererComponent
        sprite.Enable = true
        sprite.Color = Color.white
        sprite.SortingLayer = "MapLayer0"
        sprite.OrderInLayer = 20000
        sprite.FlipX = false
        sprite.FlipY = false
        entity.TransformComponent.Scale = Vector3.one
        entity.Enable = true
        entity.Visible = true
        local target = nil
        for _, child in ipairs(map.Children:ToTable()) do
            if tostring(child.Id) == entityId then target = child break end
        end
        local item = {entity = entity, target = target, mapId = mapId, effectId = effectId,
            frames = frames, index = 1, remaining = frames[1][2], pos = _BaramWorldData:Position(x, y)}
        table.insert(self._T.effects, item)
        self:DrawFrame(item)
        log("[BaramSpellEffect] start effect=" .. tostring(effectId) .. " frames=" .. tostring(#frames) .. " first=" .. frames[1][1])
    end

    @ExecSpace("ClientOnly")
    method void DrawFrame(table item)
        -- Follow the visible actor and apply the source crop offset relative to its feet.
        if isvalid(item.target) then
            ---@type BaramCreature
            local creature = item.target:GetComponent("script.BaramCreature")
            ---@type BaramPlayerVisual
            local visual = item.target:GetComponent("script.BaramPlayerVisual")
            if isvalid(creature) and isvalid(creature._T.sprite) then
                item.pos = creature._T.sprite.TransformComponent.WorldPosition - (creature._T.spriteOffset or Vector3.zero)
            elseif isvalid(visual) and isvalid(visual._T.visual) then
                item.pos = visual._T.visual.TransformComponent.WorldPosition
            end
        end
        local frame = item.frames[item.index]
        item.entity.SpriteRendererComponent.SpriteRUID = frame[1]
        item.entity.TransformComponent.Position = item.pos + Vector3(frame[3], frame[4], 0)
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        -- Advance by recorded milliseconds, including the long hold in effect 86.
        local effects = self._T.effects
        if effects == nil then return end
        local state = _BaramWorld.LocalState
        for i = #effects, 1, -1 do
            local item = effects[i]
            item.remaining = item.remaining - delta
            while item.remaining <= 0 and item.index <= #item.frames do
                item.index = item.index + 1
                if item.index <= #item.frames then item.remaining = item.remaining + item.frames[item.index][2] end
            end
            if not _BaramEntryFlow.InWorld or state == nil or state.map ~= item.mapId
                or not isvalid(item.entity) or item.index > #item.frames then
                if isvalid(item.entity) then item.entity:Destroy() end
                table.remove(effects, i)
                log("[BaramSpellEffect] end effect=" .. tostring(item.effectId))
            else self:DrawFrame(item) end
        end
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- Dispose local effects before the next play session.
        for _, item in ipairs(self._T.effects or {}) do
            if isvalid(item.entity) then item.entity:Destroy() end
        end
        self._T.effects = nil
    end
end
