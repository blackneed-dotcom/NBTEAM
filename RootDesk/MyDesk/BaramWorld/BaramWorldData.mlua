@Logic
script BaramWorldData extends Logic
    property integer InventoryCapacity = 52

    method string InventoryLetter(integer slot)
        -- winbaram 0x4D9100: slots 1..26 are a..z, 27..52 are A..Z.
        if slot >= 1 and slot <= 26 then return string.char(96 + slot) end
        if slot >= 27 and slot <= 52 then return string.char(38 + slot) end
        return " "
    end
    -- winbaram.exe: 0x554934 = 80ms; 0x4DBAC2 cycles four phases.
