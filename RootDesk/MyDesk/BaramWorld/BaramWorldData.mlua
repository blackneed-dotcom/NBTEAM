    -- Source SHA256: ffdba6a0a86a9a41a041371f9610ef4aca89a14747cb51baece9d69d2bbd42f9
    -- Default unmodified walking. Server speed levels / mounted bodies are separate source branches.
    property number WalkFrameSeconds = 0.08
    property number InputPollSeconds = 0.02
    property table WalkFrames = {0, 1, 0, 2}
