    -- Preserved Docs/BaramSource/m1-manifest.json shop order and item IDs.
    property table NpcShops = {["0"]={2200,4000,4003,4001,2201,1742,1740,1741,1738,1737,20211,2205,2204,2203,2202,2211,50200},["20"]={3014,3019,3018,3016,3017,3020,3040,3021,3029,3023,3030,3031,3032,3022,3024,3025,3028,3026,3033},["21"]={3014,3019,3018,3016,3017,3020,3037,3040,3021,3029,3023,3030,3031,3032,3022,3024,3025,3028,3026,3033,3038,3039,3040,10043,10044,10045,10046,10047,10048,10049,10050,10051,10052,10053,10054,10055,10056,10156,10117}}
    method table Map(integer id)
        return self.Maps[tostring(id)]
    end
    method table Item(integer id)
        return self.Items[tostring(id)]
    end
    method Vector3 Position(integer x, integer y)
        return Vector3((x + 0.5) * 0.24, -(y + 1) * 0.24, 0)
    end
    method boolean Walkable(integer id, integer x, integer y)
        local m = self:Map(id)
        if m == nil or x < 0 or y < 0 or x >= m.cols or y >= m.rows then return false end
        for _, p in ipairs(self.Portals) do if p.from == id and p.x == x and p.y == y then return true end end
        return string.sub(m.pass[y + 1], x + 1, x + 1) == "1"
    end
end
