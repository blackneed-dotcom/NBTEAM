    method table Map(integer id)
        return self.Maps[tostring(id)]
    end
    method table Item(integer id)
        return self.Items[tostring(id)]
    end
    method Vector3 Position(integer x, integer y)
        return Vector3((x + 0.5) * 0.24, -(y + 1) * 0.24, 0)
    end
    method boolean Walkable(integer id, integer x, integer y)
        local m = self:Map(id)
        if m == nil or x < 0 or y < 0 or x >= m.cols or y >= m.rows then return false end
        for _, p in ipairs(self.Portals) do if p.from == id and p.x == x and p.y == y then return true end end
        return string.sub(m.pass[y + 1], x + 1, x + 1) == "1"
    end
end
